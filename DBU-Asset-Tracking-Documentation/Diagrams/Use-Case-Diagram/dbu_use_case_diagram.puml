@startuml DBU_Asset_Tracking_Use_Case_Diagram
!define BOUNDARY_COLOR #333333
!define ACTOR_COLOR #000000
!define USECASE_COLOR #000000
!define LINE_COLOR #000000

skinparam backgroundColor #FFFFFF
skinparam ArrowColor LINE_COLOR
skinparam ActorBorderColor ACTOR_COLOR
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor USECASE_COLOR
skinparam UsecaseBackgroundColor #FFFFFF
skinparam RectangleBorderColor BOUNDARY_COLOR
skinparam RectangleBackgroundColor #FFFFFF
skinparam Padding 15

left to right direction

' ============================================================================
' LEFT SIDE ACTORS (4)
' ============================================================================

actor "System\nAdministrator" as ADMIN
actor "Property\nAdministration\nOfficer" as PAO
actor "Inventory\nPerson" as INV
actor "Internal\nAuditor" as AUDITOR

' ============================================================================
' RIGHT SIDE ACTORS (3)
' ============================================================================

actor "Department\nHead" as DH
actor "Staff\nMember" as SM
actor "Maintenance\nTechnician" as MT

' ============================================================================
' SYSTEM BOUNDARY WITH USE CASES
' ============================================================================

rectangle "DBU Asset Tracking System" {

  ' ========================================================================
  ' SECTION 1: AUTHENTICATION & DASHBOARD (Center-Top)
  ' ========================================================================
  
  usecase "UC01: User Login" as UC01
  usecase "UC02: View Dashboard" as UC02

  ' ========================================================================
  ' SECTION 2: ADMINISTRATION (Left-Top Area)
  ' ========================================================================

  usecase "UC03: Manage Users" as UC03
  usecase "UC04: Manage Organizational\nUnits" as UC04
  usecase "UC05: Manage Faculties" as UC05

  ' ========================================================================
  ' SECTION 3: ASSET MANAGEMENT (Left-Middle Area)
  ' ========================================================================

  usecase "UC06: Register Asset" as UC06
  usecase "UC07: Manage Assets" as UC07
  usecase "UC08: Manage Asset\nCategories" as UC08
  usecase "UC09: Manage Asset Types" as UC09
  usecase "UC10: Search and Filter\nAssets" as UC10
  usecase "UC11: Generate\nQR Code" as UC11
  usecase "UC12: Verify Asset\n(Public)" as UC12

  ' ========================================================================
  ' SECTION 4: REQUESTS (Center Area)
  ' ========================================================================

  usecase "UC13: Request Asset" as UC13
  usecase "UC14: Review Asset\nRequests" as UC14

  ' ========================================================================
  ' SECTION 5: ASSIGNMENT & RETURNS (Center-Right Area)
  ' ========================================================================

  usecase "UC15: Assign Asset" as UC15
  usecase "UC16: Accept Asset" as UC16
  usecase "UC17: Reject Asset" as UC17
  usecase "UC18: Request Asset\nReturn" as UC18
  usecase "UC19: Process Asset\nReturn" as UC19
  usecase "UC20: Reassign Asset" as UC20

  ' ========================================================================
  ' SECTION 6: MAINTENANCE (Right-Middle Area)
  ' ========================================================================

  usecase "UC21: Manage\nMaintenance" as UC21

  ' ========================================================================
  ' SECTION 7: INVENTORY & VERIFICATION (Lower-Left/Center Area)
  ' ========================================================================

  usecase "UC22: Verify Inventory" as UC22
  usecase "UC23: Monitor Inventory\nSessions" as UC23

  ' ========================================================================
  ' SECTION 8: AUDIT & FINANCIAL (Lower-Left Area)
  ' ========================================================================

  usecase "UC24: Audit Asset\nRecords" as UC24
  usecase "UC25: Manage Financial\nInformation" as UC25
  usecase "UC26: Manage Depreciation\nand Valuation" as UC26

}

' ============================================================================
' ASSOCIATIONS: SYSTEM ADMINISTRATOR (Top-Left)
' ============================================================================

ADMIN --> UC01
ADMIN --> UC02
ADMIN --> UC03
ADMIN --> UC04
ADMIN --> UC05
ADMIN --> UC06
ADMIN --> UC07
ADMIN --> UC08
ADMIN --> UC09
ADMIN --> UC14
ADMIN --> UC24
ADMIN --> UC25
ADMIN --> UC26

' ============================================================================
' ASSOCIATIONS: PROPERTY ADMINISTRATION OFFICER (Middle-Left)
' ============================================================================

PAO --> UC01
PAO --> UC02
PAO --> UC06
PAO --> UC07
PAO --> UC08
PAO --> UC09
PAO --> UC10
PAO --> UC11
PAO --> UC12
PAO --> UC14
PAO --> UC15
PAO --> UC19
PAO --> UC20
PAO --> UC25
PAO --> UC26

' ============================================================================
' ASSOCIATIONS: INVENTORY PERSON (Lower-Left)
' ============================================================================

INV --> UC01
INV --> UC02
INV --> UC10
INV --> UC11
INV --> UC12
INV --> UC22
INV --> UC23

' ============================================================================
' ASSOCIATIONS: INTERNAL AUDITOR (Bottom-Left)
' ============================================================================

AUDITOR --> UC01
AUDITOR --> UC02
AUDITOR --> UC24
AUDITOR --> UC25
AUDITOR --> UC26

' ============================================================================
' ASSOCIATIONS: DEPARTMENT HEAD (Top-Right)
' ============================================================================

DH --> UC01
DH --> UC02
DH --> UC13
DH --> UC14
DH --> UC18

' ============================================================================
' ASSOCIATIONS: STAFF MEMBER (Middle-Right)
' ============================================================================

SM --> UC01
SM --> UC02
SM --> UC10
SM --> UC13
SM --> UC16
SM --> UC17
SM --> UC18

' ============================================================================
' ASSOCIATIONS: MAINTENANCE TECHNICIAN (Bottom-Right)
' ============================================================================

MT --> UC01
MT --> UC02
MT --> UC21

' ============================================================================
' USE CASE RELATIONSHIPS (INCLUDES & EXTENDS)
' ============================================================================

UC01 ..> UC02 : <<include>>
UC13 ..> UC10 : <<include>>
UC06 ..> UC11 : <<include>>
UC07 ..> UC12 : <<include>>
UC15 ..> UC16 : <<include>>
UC15 ..> UC17 : <<include>>
UC18 ..> UC19 : <<include>>
UC21 ..> UC07 : <<include>>

@enduml
